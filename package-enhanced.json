{
  "name": "tired-error-explainer",
  "version": "0.2.0",
  "description": "A rule-based CLI that turns ugly developer errors into practical explanations.",
  "type": "module",
  "bin": {
    "tired-error": "./bin/tired-error.js"
  },
  "scripts": {
    "start": "node ./bin/tired-error.js",
    "test": "node ./test/run-tests.js",
    "test:watch": "node --watch ./test/run-tests.js",
    "test:rules": "node ./test/rule-tests.js",
    "lint": "eslint src bin test",
    "lint:fix": "eslint src bin test --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "validate": "npm run lint && npm run format:check && npm test",
    "prepublishOnly": "npm run validate"
  },
  "keywords": [
    "errors",
    "debugging",
    "cli",
    "developer-tools",
    "error-explanations",
    "troubleshooting"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/tired-error-explainer.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/tired-error-explainer/issues"
  },
  "homepage": "https://github.com/yourusername/tired-error-explainer#readme"
}
